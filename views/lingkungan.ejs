<%- include('partials/header') %>

<main class="pt-24 min-h-screen bg-slate-50">
    <section class="py-16">
        <div class="container mx-auto px-6">
            <!-- Breadcrumb-like back button -->
            <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-emerald-600 font-bold text-sm mb-8 transition-colors group">
                <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-1"></i> Kembali ke Beranda
            </a>

            <div class="max-w-4xl mb-16">
                <h1 class="text-4xl lg:text-5xl font-black text-slate-900 mb-6 tracking-tight">
                    Program Relawan <span class="text-emerald-500">Lingkungan</span>
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Bumi adalah rumah kita satu-satunya. Bergabunglah dalam misi menjaga dan merawatnya untuk generasi mendatang. Setiap pohon yang kita tanam adalah napas baru bagi dunia.
                </p>
                <div class="mt-4 p-4 bg-emerald-50 rounded-2xl border border-emerald-100">
                    <p class="text-emerald-800 font-medium">
                        Mari satukan aksi, wujudkan perubahan nyata. Jadilah bagian dari solusi, bukan polusi: <strong>menanam, membersihkan, dan mengedukasi</strong>.
                    </p>
                </div>
            </div>

            <%
            const environmentPrograms = [
                {
                    emoji: "🌳",
                    title: "Aksi Tanam Mangrove",
                    slug: "tanam-mangrove",
                    cta: "Satu mangrove yang kau tanam hari ini adalah perisai bagi pesisir di masa depan. Ayo, ikut lestarikan ekosistem laut kita!",
                    schedule: "Sesuai jadwal proyek",
                    location: "Pesisir Pantai Utara",
                    target: "50 Relawan",
                    reward: "Koin + Lencana Pelestari"
                },
                {
                    emoji: "🌊",
                    title: "Clean-Up Day",
                    slug: "clean-up-day",
                    cta: "Jangan biarkan sampah merusak keindahan alam kita. Pungut satu sampah, selamatkan ribuan biota laut.",
                    schedule: "Setiap bulan sekali",
                    location: "Pantai atau Tepi Sungai",
                    target: "Terbuka untuk Umum",
                    reward: "Koin + Lencana Kebersihan"
                },
                {
                    emoji: "♻️",
                    title: "Workshop Zero Waste",
                    slug: "workshop-zero-waste",
                    cta: "Ubah sampah jadi berkah. Belajar cara mengelola sampah rumah tangga menjadi barang berguna dan kompos.",
                    schedule: "Akhir Pekan",
                    location: "Balai Warga / Online",
                    target: "30 Peserta",
                    reward: "Koin + Lencana Daur Ulang"
                },
                {
                    emoji: "🌱",
                    title: "Adopsi Pohon",
                    slug: "adopsi-pohon",
                    cta: "Miliki pohonmu sendiri dan pantau pertumbuhannya. Satu pohon darimu, investasi oksigen untuk masa depan.",
                    schedule: "Donasi Terbuka",
                    location: "Lahan Kritis Hutan",
                    target: "Penyumbang Dana",
                    reward: "Koin + Lencana Penghijauan"
                }
            ];
            %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% environmentPrograms.forEach(function(item, index) { %>
                <div class="standard-card flex flex-col h-full group hover:border-emerald-200">
                    <div class="flex items-start justify-between mb-8">
                        <div class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center text-3xl transition-transform group-hover:scale-110">
                            <%= item.emoji %>
                        </div>
                        <span class="px-3 py-1 bg-emerald-50 text-emerald-600 rounded-full text-[10px] font-bold uppercase tracking-wider">Lingkungan</span>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-emerald-500 transition-colors"><%= item.title %></h3>
                    <p class="text-slate-500 italic mb-8 flex-grow">"<%= item.cta %>"</p>

                    <div class="space-y-4 mb-10">
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-calendar-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Jadwal</p>
                                <p class="text-slate-700 font-bold"><%= item.schedule %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-map-marker-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Lokasi</p>
                                <p class="text-slate-700 font-bold"><%= item.location %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-users text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Kapasitas</p>
                                <p class="text-slate-700 font-bold"><%= item.target %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-500">
                                <i class="fas fa-award text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Reward</p>
                                <p class="text-slate-700 font-bold"><%= item.reward %></p>
                            </div>
                        </div>
                    </div>

                    <a href="/daftar-lingkungan/<%= item.slug %>" class="btn-main bg-emerald-500 text-white hover:bg-emerald-600 shadow-lg shadow-emerald-500/20 w-full">
                        <%= item.slug === 'adopsi-pohon' ? 'Adopsi Sekarang' : 'Daftar Sekarang' %> <i class="fas fa-arrow-right ml-2 text-xs"></i>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
