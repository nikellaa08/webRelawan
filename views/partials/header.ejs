<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relawan Nusantara - Platform Relawan & Donasi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              emerald: {
                50: '#ecfdf5',
                500: '#10b981',
                600: '#059669',
              },
              slate: {
                50: '#f8fafc',
              }
            },
            fontFamily: {
              sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
            },
            borderRadius: {
              '2xl': '1rem',
              '3xl': '1.5rem',
            }
          }
        }
      }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        /* Override some existing styles to work with Tailwind */
        .navbar { z-index: 50; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
    </style>
</head>
<body class="">

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="main-container flex justify-between items-center h-full">
            <a href="/" class="nav-logo">
                Relawan<span class="text-emerald-500">Nusantara</span>
            </a>
            <ul class="nav-menu">
                <li class="nav-item"><a href="/pendidikan">Pendidikan</a></li>
                <li class="nav-item"><a href="/lingkungan">Lingkungan</a></li>
                <li class="nav-item"><a href="/kesehatan">Kesehatan</a></li>
                <li class="nav-item"><a href="/sosial-kemanusiaan">Sosial & Kemanusiaan</a></li>
            </ul>
            <div class="nav-right">
                <% if (typeof user !== 'undefined' && user) { %>
                    <!-- User sudah login - Tampilkan sapaan -->
                    <div class="nav-user-greeting">
                        <i class="fas fa-user-circle"></i>
                        <span>Halo, <%= user.name %>!</span>
                    </div>
                    <a href="/logout" class="btn-main border border-rose-200 text-rose-500 hover:bg-rose-50 px-6 py-2 text-sm">
                        Keluar
                    </a>
                <% } else { %>
                    <!-- User belum login - Tampilkan tombol Login -->
                    <a href="/login" class="btn-main btn-main-primary px-8 py-2.5 text-sm">
                        Masuk
                    </a>
                <% } %>
            </div>
            <div class="hamburger">
                <div class="bar1"></div>
                <div class="bar2"></div>
                <div class="bar3"></div>
            </div>
        </div>
    </nav>
