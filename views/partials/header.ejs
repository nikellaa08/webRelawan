<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relawan Nusantara - Platform Relawan & Donasi</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    
    <style>
        /* CSS Navbar Tetap di Atas */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: white;
            padding: 15px 5%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Berikan ruang agar konten tidak tertutup navbar fixed */
        body {
            padding-top: 80px; 
        }

        .nav-logo {
            font-weight: 700;
            font-size: 1.5rem;
            color: #764ba2;
            text-decoration: none;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 25px;
            margin: 0;
            padding: 0;
        }

        .nav-item a {
            text-decoration: none;
            color: #444;
            font-weight: 500;
            transition: 0.3s;
            font-size: 0.95rem;
        }

        .nav-item a:hover { color: #667eea; }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .btn-admin-panel {
            background: #ffc107;
            color: #000 !important;
            padding: 8px 18px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }

        .btn-admin-panel:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .btn-login-modern {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white !important;
            padding: 10px 25px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        .nav-user-greeting {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            color: #555;
        }

        .flash-message {
            position: fixed;
            top: 100px;
            right: 20px;
            padding: 15px 25px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            z-index: 2000;
            animation: slideIn 0.5s ease-out;
            border-left: 5px solid #667eea;
        }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/" class="nav-logo">
            <i class="fas fa-hand-holding-heart"></i> Relawan Nusantara
        </a>

        <ul class="nav-menu">
            <li class="nav-item"><a href="/pendidikan">Pendidikan</a></li>
            <li class="nav-item"><a href="/lingkungan">Lingkungan</a></li>
            <li class="nav-item"><a href="/kesehatan">Kesehatan</a></li>
            <li class="nav-item"><a href="/sosial-kemanusiaan">Sosial</a></li>
        </ul>

        <div class="nav-right">
            <% if (locals.admin) { %>
                <a href="/admin/dashboard" class="btn-admin-panel">
                    <i class="fas fa-user-shield"></i> Dashboard Admin
                </a>
            <% } %>

            <% if (locals.user) { %>
                <div class="nav-user-greeting">
                    <span>Hi, <%= user.name %>!</span>
                </div>
                <a href="/logout" class="btn-logout-minimal" style="color: #dc3545; text-decoration: none; margin-left: 10px;">
                    <i class="fas fa-power-off"></i>
                </a>
            <% } else if (!locals.admin) { %>
                <a href="/login" class="btn-login-modern">
                    Login
                </a>
            <% } %>
        </div>
    </nav>

    <% if (locals.message) { %>
        <div class="flash-message">
            <i class="fas fa-info-circle"></i> <%= message %>
        </div>
        <script>
            setTimeout(() => {
                const msg = document.querySelector('.flash-message');
                if (msg) msg.style.display = 'none';
            }, 5000);
        </script>
    <% } %>
