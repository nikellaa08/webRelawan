<%- include('partials/header') %>

    <style>
        body { 
            background: #010409; 
            color: white; 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            min-height: 100vh; 
            margin: 0; 
        }
        .container-it {
            display: flex; justify-content: center; align-items: center; padding-top: 120px; padding-bottom: 60px;
        }
        .card-it { background: #0d1117; border: 1px solid #30363d; border-radius: 30px; max-width: 450px; width: 90%; overflow: hidden; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.5); }
        .banner-it { background: linear-gradient(135deg, #0066ff, #00f2ff); padding: 40px; font-size: 5rem; }
        .content-it { padding: 30px; }
        .btn-it { background: #00f2ff; color: black; border: none; padding: 18px; width: 100%; border-radius: 15px; font-weight: 800; cursor: pointer; font-size: 1rem; transition: 0.3s; }
        .btn-it:hover { transform: scale(1.02); background: #fff; }
    </style>

    <div class="container-it">
        <div class="card-it">
            <div class="banner-it">💻</div>
            <div class="content-it">
                <h1 style="color: #00f2ff; margin: 0;">Literasi Digital</h1>
                <p style="color: #8b949e; margin: 15px 0;">Bantu remaja desa melek teknologi dan coding dasar.</p>
                <p style="font-size: 1.2rem;">🪙 <b>Reward: 350 Koin</b></p>
                <button class="btn-it" onclick="ambil(350, 'Literasi Digital')">Ambil Misi Sekarang</button>
                <br><br><a href="/pendidikan" style="color: #8b949e; text-decoration: none; font-size: 0.9rem;">← Kembali ke Daftar</a>
            </div>
        </div>
    </div>
    <script>
        function ambil(r, n) {
            let koin = parseInt(localStorage.getItem('relawan_koin')) || 0;
            localStorage.setItem('relawan_koin', koin + r);
            alert('Berhasil! Misi ' + n + ' diambil. + ' + r + ' koin!');
            window.location.href = '/pendidikan';
        }
    </script>
</body>
</html>
