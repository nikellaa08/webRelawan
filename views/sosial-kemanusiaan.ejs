<%- include('partials/header') %>

<main class="pt-24 min-h-screen bg-slate-50">
    <section class="py-16">
        <div class="container mx-auto px-6">
            <!-- Breadcrumb-like back button -->
            <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-purple-600 font-bold text-sm mb-8 transition-colors group">
                <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-1"></i> Kembali ke Beranda
            </a>

            <div class="max-w-4xl mb-16">
                <h1 class="text-4xl lg:text-5xl font-black text-slate-900 mb-6 tracking-tight">
                    Program <span class="text-purple-600">Sosial & Kemanusiaan</span>
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Bergabunglah bersama kami dalam gerakan kebaikan yang nyata. Dari anak-anak panti asuhan hingga lansia di panti jompo, kehadiranmu adalah arti dan harapan bagi mereka yang sering terlupakan.
                </p>
                <div class="mt-4 p-4 bg-purple-50 rounded-2xl border border-purple-100">
                    <p class="text-purple-800 font-medium">
                        Mari wujudkan kepedulian dalam aksi: <strong>berbagi, menemani, dan menguatkan</strong>. Perubahan besar berawal dari hati yang peduli.
                    </p>
                </div>
            </div>

            <%
            const socialPrograms = [
                {
                    emoji: "👕",
                    title: "Donasi Pakaian",
                    slug: "donasi-pakaian",
                    cta: "Satu pakaian layak pakai darimu bisa menghangatkan harapan mereka. Yuk berbagi kepedulian bagi sesama.",
                    schedule: "Sesuai jadwal pengumpulan",
                    location: "Panti Asuhan / Korban Bencana",
                    target: "Anak-anak & Lansia",
                    reward: "Koin + Lencana Donatur"
                },
                {
                    emoji: "📚",
                    title: "Donasi Buku",
                    slug: "donasi-buku",
                    cta: "Buku yang tak lagi kau baca bisa membuka jendela dunia bagi mereka. Mari berbagi ilmu, wujudkan mimpi bersama.",
                    schedule: "Sesuai jadwal pengumpulan",
                    location: "Sekolah Terpencil / Taman Baca",
                    target: "Anak-anak Pelajar",
                    reward: "Koin + Lencana Donatur"
                },
                {
                    emoji: "🏠",
                    title: "Kunjungan Panti Asuhan",
                    slug: "kunjungan-panti-asuhan",
                    cta: "Kehadiranmu adalah hadiah terindah. Jadilah kakak, sahabat, dan sumber semangat bagi anak-anak panti.",
                    schedule: "Sesuai jadwal kunjungan",
                    location: "Panti Asuhan Binaan",
                    target: "Semua Relawan",
                    reward: "Koin + Lencana Peduli"
                },
                {
                    emoji: "👴",
                    title: "Kunjungan Panti Jompo",
                    slug: "kunjungan-panti-jompo",
                    cta: "Mereka hanya butuh waktu dan perhatian. Hadirmu adalah kebahagiaan yang tak ternilai bagi para lansia.",
                    schedule: "Sesuai jadwal kunjungan",
                    location: "Panti Jompo Lansia",
                    target: "Semua Relawan",
                    reward: "Koin + Lencana Peduli"
                }
            ];
            %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% socialPrograms.forEach(function(item, index) { %>
                <div class="standard-card flex flex-col h-full group hover:border-purple-200">
                    <div class="flex items-start justify-between mb-8">
                        <div class="w-14 h-14 bg-purple-100 rounded-2xl flex items-center justify-center text-3xl transition-transform group-hover:scale-110">
                            <%= item.emoji %>
                        </div>
                        <span class="px-3 py-1 bg-purple-50 text-purple-600 rounded-full text-[10px] font-bold uppercase tracking-wider">Sosial</span>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-purple-600 transition-colors"><%= item.title %></h3>
                    <p class="text-slate-500 italic mb-8 flex-grow">"<%= item.cta %>"</p>

                    <div class="space-y-4 mb-10">
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-calendar-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Waktu</p>
                                <p class="text-slate-700 font-bold"><%= item.schedule %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-map-marker-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Lokasi</p>
                                <p class="text-slate-700 font-bold"><%= item.location %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-hand-holding-heart text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Target</p>
                                <p class="text-slate-700 font-bold"><%= item.target %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-500">
                                <i class="fas fa-award text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Reward</p>
                                <p class="text-slate-700 font-bold"><%= item.reward %></p>
                            </div>
                        </div>
                    </div>

                    <a href="/daftar-sosial/<%= item.slug %>" class="btn-main bg-purple-600 text-white hover:bg-purple-700 shadow-lg shadow-purple-600/20 w-full">
                        Ikut Sekarang <i class="fas fa-arrow-right ml-2 text-xs"></i>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
