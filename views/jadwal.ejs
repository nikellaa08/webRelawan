<%- include('partials/header') %>

    <style>
        .calendar-container-jadwal {
            max-width: 900px;
            margin: 120px auto 60px;
            padding: 30px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .calendar-header-jadwal {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .calendar-header-jadwal h2 {
            color: #764ba2;
        }
        .calendar-jadwal {
            width: 100%;
            border-collapse: collapse;
        }
        .calendar-jadwal th, .calendar-jadwal td {
            text-align: center;
            padding: 15px;
            border: 1px solid #eee;
        }
        .calendar-jadwal th {
            background: #f9f9f9;
            font-weight: 600;
        }
        .calendar-jadwal td {
            height: 80px;
            vertical-align: top;
            font-weight: 600;
        }
        .calendar-jadwal .day-number-jadwal {
            font-size: 0.9em;
            color: #999;
        }
        .calendar-jadwal .today-jadwal {
            background-color: #e7f3ff;
        }
        .calendar-jadwal .event-jadwal {
            background-color: #28a745;
            color: white;
            border-radius: 5px;
            padding: 5px;
            font-size: 0.8em;
            margin-top: 5px;
            cursor: pointer;
        }
        .calendar-jadwal .other-month-jadwal {
            color: #ccc;
        }
        .event-list-jadwal {
            margin-top: 40px;
        }
        .event-list-jadwal h3 {
            color: #764ba2;
            margin-bottom: 20px;
        }
        .event-item-jadwal {
            background: #f9f9f9;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            border-left: 5px solid #28a745;
        }
    </style>

    <!-- CALENDAR SECTION -->
    <section class="section">
        <div class="calendar-container-jadwal">
            <div class="calendar-header-jadwal">
                <button class="btn btn-secondary">&lt; Prev</button>
                <h2>Mei 2026</h2>
                <button class="btn btn-secondary">Next &gt;</button>
            </div>
            <table class="calendar-jadwal">
                <thead>
                    <tr><th>Min</th><th>Sen</th><th>Sel</th><th>Rab</th><th>Kam</th><th>Jum</th><th>Sab</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="other-month-jadwal"><span class="day-number-jadwal">26</span></td>
                        <td class="other-month-jadwal"><span class="day-number-jadwal">27</span></td>
                        <td class="other-month-jadwal"><span class="day-number-jadwal">28</span></td>
                        <td class="other-month-jadwal"><span class="day-number-jadwal">29</span></td>
                        <td class="other-month-jadwal"><span class="day-number-jadwal">30</span></td>
                        <td><span class="day-number-jadwal">1</span></td>
                        <td><span class="day-number-jadwal">2</span></td>
                    </tr>
                    <tr>
                        <td><span class="day-number-jadwal">3</span></td>
                        <td><span class="day-number-jadwal">4</span></td>
                        <td class="today-jadwal"><span class="day-number-jadwal">5</span></td>
                        <td><span class="day-number-jadwal">6</span></td>
                        <td><span class="day-number-jadwal">7</span></td>
                        <td><span class="day-number-jadwal">8</span></td>
                        <td><span class="day-number-jadwal">9</span></td>
                    </tr>
                    <tr>
                        <td><span class="day-number-jadwal">10</span></td>
                        <td><span class="day-number-jadwal">11</span></td>
                        <td><span class="day-number-jadwal">12</span></td>
                        <td><span class="day-number-jadwal">13</span></td>
                        <td><span class="day-number-jadwal">14</span></td>
                        <td>
                            <span class="day-number-jadwal">15</span>
                            <div class="event-jadwal">Aksi Tanam Pohon</div>
                        </td>
                        <td><span class="day-number-jadwal">16</span></td>
                    </tr>
                    <tr>
                        <td><span class="day-number-jadwal">17</span></td>
                        <td><span class="day-number-jadwal">18</span></td>
                        <td><span class="day-number-jadwal">19</span></td>
                        <td><span class="day-number-jadwal">20</span></td>
                        <td><span class="day-number-jadwal">21</span></td>
                        <td><span class="day-number-jadwal">22</span></td>
                        <td><span class="day-number-jadwal">23</span></td>
                    </tr>
                </tbody>
            </table>
            
            <div class="event-list-jadwal">
                <h3>Daftar Jadwal Penjemputan & Event Donasi</h3>
                <div class="event-item-jadwal">
                    <strong>15 Mei 2026:</strong> Penjemputan donasi pakaian di wilayah Jakarta. Relawan akan menghubungi donatur H-1 untuk konfirmasi.
                </div>
                <div class="event-item-jadwal" style="border-left-color: #ffc107;">
                    <strong>20 Mei 2026:</strong> Kunjungan ke Panti Asuhan Kasih. Batas pendaftaran relawan hingga 18 Mei 2026.
                </div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <p>&copy; 2026 Relawan Nusantara. Semua Hak Dilindungi.</p>
    </footer>
</body>
</html>
