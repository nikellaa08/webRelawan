<%- include('partials/header') %>

<style>
    /* Compact Modern Calendar Styles with Stable Navigation */
    .calendar-page-bg {
        background-color: #f8fafc;
        padding-top: 100px;
        padding-bottom: 80px;
        min-height: 100vh;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    }

    .calendar-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Fixed-Width Header for Zero-Shift Navigation */
    .calendar-header-card {
        background: white;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        margin-bottom: 24px;
        text-align: center;
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .nav-flex {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
    }

    .month-box {
        min-width: 250px; /* Fixed width to prevent button shifting */
        display: inline-block;
    }

    .current-month {
        font-size: 2.25rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0;
        letter-spacing: -1.5px;
    }

    .nav-btn {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        background: white;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-btn:hover {
        background: #10b981;
        color: white;
        border-color: #10b981;
        transform: translateY(-2px);
    }

    .year-select-pill {
        margin-top: 15px;
        padding: 6px 20px;
        border-radius: 50px;
        border: 1.5px solid #e2e8f0;
        background: #f8fafc;
        font-weight: 800;
        color: #475569;
        font-size: 0.9rem;
        cursor: pointer;
        outline: none;
        transition: border-color 0.3s;
    }

    .year-select-pill:focus {
        border-color: #10b981;
    }

    /* Grid & Typography */
    .calendar-grid-card {
        background: white;
        border-radius: 32px;
        padding: 30px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    .grid-layout {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 10px;
    }

    .weekday-header {
        text-align: center;
        font-weight: 900;
        color: #1e293b;
        font-size: 1rem;
        padding-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .day-cell {
        aspect-ratio: 1 / 1;
        background: #f8fafc;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 2px solid transparent;
        position: relative;
    }

    .day-cell:hover:not(.empty) {
        background: white;
        border-color: #10b981;
        transform: scale(1.05);
        z-index: 10;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .day-cell.today {
        background: #ecfdf5;
        border-color: #10b981;
    }

    .day-cell.holiday .date-num {
        color: #ef4444 !important;
    }

    .date-num {
        font-weight: 800;
        font-size: 1.1rem;
        color: #64748b;
    }

    .dot-box {
        display: flex;
        gap: 3px;
        margin-top: 4px;
    }

    .dot-sm { width: 5px; height: 5px; border-radius: 50%; }
    .dot-pendidikan { background-color: #3b82f6; }
    .dot-lingkungan { background-color: #10b981; }
    .dot-kesehatan { background-color: #e11d48; }
    .dot-sosial { background-color: #8b5cf6; }

    /* Tooltip */
    .day-cell[data-title]:hover::after {
        content: attr(data-title);
        position: absolute;
        bottom: 120%;
        left: 50%;
        transform: translateX(-50%);
        background: #0f172a;
        color: white;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.7rem;
        white-space: nowrap;
        z-index: 100;
        font-weight: 700;
    }

    /* Dynamic Agenda */
    .agenda-area { margin-top: 50px; }
    .agenda-title { font-weight: 900; color: #0f172a; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; }
    
    .agenda-item {
        background: white;
        border-radius: 20px;
        padding: 16px 24px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 20px;
        border: 1px solid #f1f5f9;
        transition: all 0.3s ease;
    }

    .agenda-item:hover { transform: translateX(8px); border-color: #e2e8f0; }
    
    .date-circle {
        width: 54px;
        height: 54px;
        background: #f8fafc;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .day-val { font-size: 1.25rem; font-weight: 900; color: #0f172a; line-height: 1; }
    .mon-val { font-size: 0.65rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; }

    .agenda-info { flex-grow: 1; }
    .agenda-info h4 { font-weight: 800; color: #1e293b; margin-bottom: 4px; }
    .agenda-info p { font-size: 0.85rem; color: #64748b; margin: 0; }

    .cat-badge {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 6px;
        margin-bottom: 8px;
        display: inline-block;
    }

    .badge-pendidikan { background: #eff6ff; color: #3b82f6; }
    .badge-lingkungan { background: #ecfdf5; color: #10b981; }
    .badge-kesehatan { background: #fff1f2; color: #e11d48; }
    .badge-sosial { background: #f5f3ff; color: #8b5cf6; }

    .fade-in { animation: fadeIn 0.4s ease-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 768px) {
        .month-box { min-width: 200px; }
        .current-month { font-size: 1.5rem; }
    }
</style>

<main class="calendar-page-bg">
    <div class="calendar-container">
        
        <!-- Header: Centered & Stable -->
        <div class="calendar-header-card">
            <div class="nav-flex">
                <button class="nav-btn" onclick="prevMonth()"><i class="fas fa-chevron-left"></i></button>
                <div class="month-box">
                    <h2 id="monthDisplay" class="current-month">Mei 2026</h2>
                </div>
                <button class="nav-btn" onclick="nextMonth()"><i class="fas fa-chevron-right"></i></button>
            </div>
            <select id="yearSelect" class="year-select-pill" onchange="changeYear(this.value)">
                <!-- 2020 - 2030 -->
            </select>
        </div>

        <!-- Grid: Compact & Bold -->
        <div class="calendar-grid-card">
            <div class="grid-layout">
                <div class="weekday-header">Min</div>
                <div class="weekday-header">Sen</div>
                <div class="weekday-header">Sel</div>
                <div class="weekday-header">Rab</div>
                <div class="weekday-header">Kam</div>
                <div class="weekday-header">Jum</div>
                <div class="weekday-header">Sab</div>
            </div>
            <div id="calendarDays" class="grid-layout fade-in">
                <!-- Days Injected Here -->
            </div>
        </div>

        <!-- Agenda: Dynamic Filtering -->
        <div class="agenda-area">
            <h3 class="agenda-title">
                <i class="fas fa-calendar-check text-emerald-500"></i> Agenda Bulan Ini
            </h3>
            <div id="agendaList" class="fade-in">
                <!-- Agenda Items Injected Here -->
            </div>
        </div>
    </div>
</main>

<script>
    const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
    
    // Simulations
    const holidays = {
        '05-01': 'Hari Buruh Internasional',
        '05-14': 'Kenaikan Isa Almasih',
        '05-16': 'Hari Raya Waisak',
        '06-01': 'Hari Lahir Pancasila',
        '08-17': 'Hari Kemerdekaan RI'
    };

    const eventData = {
        '2026-05-15': [{ title: 'Aksi Tanam Mangrove', cat: 'lingkungan', loc: 'Pesisir Utara, Jakarta' }],
        '2026-05-20': [{ title: 'Bimbingan Belajar Gratis', cat: 'pendidikan', loc: 'Rumah Belajar Pintar' }],
        '2026-05-25': [{ title: 'Donor Darah Nasional', cat: 'kesehatan', loc: 'PMI Cabang Pusat' }],
        '2026-05-30': [{ title: 'Kunjungan Panti Jompo', cat: 'sosial', loc: 'Wisma Lansia Bahagia' }],
        '2026-06-05': [{ title: 'Workshop Zero Waste', cat: 'lingkungan', loc: 'Balai Warga RW 05' }]
    };

    let currentDate = new Date(2026, 4, 1);

    function init() {
        const select = document.getElementById('yearSelect');
        for (let y = 2020; y <= 2030; y++) {
            const opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            if (y === 2026) opt.selected = true;
            select.appendChild(opt);
        }
        render();
    }

    function render() {
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();
        
        document.getElementById('monthDisplay').textContent = `${monthNames[month]} ${year}`;
        document.getElementById('yearSelect').value = year;

        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        
        const grid = document.getElementById('calendarDays');
        const list = document.getElementById('agendaList');
        
        grid.innerHTML = '';
        list.innerHTML = '';
        
        grid.classList.remove('fade-in');
        void grid.offsetWidth;
        grid.classList.add('fade-in');

        // Padding
        for (let i = 0; i < firstDay; i++) {
            const empty = document.createElement('div');
            empty.className = 'day-cell empty';
            grid.appendChild(empty);
        }

        const today = new Date();
        let eventsFound = [];

        for (let d = 1; d <= daysInMonth; d++) {
            const cell = document.createElement('div');
            cell.className = 'day-cell';
            
            const mKey = String(month + 1).padStart(2, '0');
            const dKey = String(d).padStart(2, '0');
            const dateStr = `${year}-${mKey}-${dKey}`;
            const holidayKey = `${mKey}-${dKey}`;

            if (year === today.getFullYear() && month === today.getMonth() && d === today.getDate()) cell.classList.add('today');
            if (holidays[holidayKey]) {
                cell.classList.add('holiday');
                cell.setAttribute('data-title', `Libur: ${holidays[holidayKey]}`);
            }

            cell.innerHTML = `<span class="date-num">${d}</span>`;

            if (eventData[dateStr]) {
                const dots = document.createElement('div');
                dots.className = 'dot-box';
                eventData[dateStr].forEach(ev => {
                    const dot = document.createElement('div');
                    dot.className = `dot-sm dot-${ev.cat}`;
                    dots.appendChild(dot);
                    eventsFound.push({ day: d, ...ev });
                });
                cell.appendChild(dots);
                cell.setAttribute('data-title', eventData[dateStr][0].title);
            }

            grid.appendChild(cell);
        }

        if (eventsFound.length > 0) {
            eventsFound.sort((a,b) => a.day - b.day).forEach(ev => {
                const item = document.createElement('div');
                item.className = 'agenda-item';
                item.innerHTML = `
                    <div class="date-circle">
                        <span class="day-val">${ev.day}</span>
                        <span class="mon-val">${monthNames[month].substring(0,3)}</span>
                    </div>
                    <div class="agenda-info">
                        <span class="cat-badge badge-${ev.cat}">${ev.cat}</span>
                        <h4>${ev.title}</h4>
                        <p><i class="fas fa-map-marker-alt mr-1"></i> ${ev.loc}</p>
                    </div>
                `;
                list.appendChild(item);
            });
        } else {
            list.innerHTML = '<p class="text-slate-400 italic text-sm text-center py-8">Tidak ada jadwal relawan bulan ini.</p>';
        }
    }

    function nextMonth() { currentDate.setMonth(currentDate.getMonth() + 1); render(); }
    function prevMonth() { currentDate.setMonth(currentDate.getMonth() - 1); render(); }
    function changeYear(val) { currentDate.setFullYear(parseInt(val)); render(); }

    document.addEventListener('DOMContentLoaded', init);
</script>

<%- include('partials/footer') %>
