<%- include('partials/header') %>

<main class="min-h-screen flex items-center justify-center bg-slate-50 py-32 px-6">
    <div class="max-w-5xl w-full bg-white rounded-[2rem] shadow-2xl shadow-slate-200/50 overflow-hidden flex flex-col md:flex-row-reverse border border-slate-100">
        
        <!-- Right Side: Form -->
        <div class="flex-1 p-8 md:p-16">
            <div class="max-w-sm mx-auto">
                <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-emerald-600 font-bold text-sm mb-12 transition-colors group">
                    <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-1"></i> Kembali ke Beranda
                </a>

                <div class="mb-10">
                    <h1 class="text-3xl font-black text-slate-900 mb-3 tracking-tight">Daftar Akun</h1>
                    <p class="text-slate-500">Mulai perjalanan kebaikan Anda hari ini bersama Relawan Nusantara.</p>
                </div>

                <form action="/api/register" method="POST" class="space-y-5">
                    <div class="grid grid-cols-1 gap-5">
                        <div>
                            <label for="username" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Username</label>
                            <input type="text" id="username" name="username" placeholder="Pilih username" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="nama_lengkap" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Nama Lengkap</label>
                            <input type="text" id="nama_lengkap" name="nama_lengkap" placeholder="Nama lengkap sesuai KTP" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="email" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Email</label>
                            <input type="email" id="email" name="email" placeholder="contoh@email.com" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="whatsapp" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Nomor WhatsApp</label>
                            <input type="tel" id="whatsapp" name="whatsapp" placeholder="0812xxxx" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="password" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Password</label>
                            <div class="relative">
                                <input type="password" id="password" name="password" placeholder="Minimal 6 karakter" required minlength="6"
                                    class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                                <button type="button" id="togglePassword" class="absolute right-6 top-1/2 -translate-y-1/2 text-slate-300 hover:text-slate-500 transition-colors">
                                    <i class="fas fa-eye" id="eye-icon"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-emerald-500 text-white py-4 rounded-2xl font-bold hover:bg-emerald-600 shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 mt-4">
                        Daftar Sekarang <i class="fas fa-user-plus text-xs"></i>
                    </button>
                </form>

                <div class="mt-10 pt-10 border-t border-slate-100 text-center md:hidden">
                    <p class="text-slate-500 text-sm mb-4">Sudah punya akun?</p>
                    <a href="/login" class="text-emerald-600 font-bold hover:underline">Masuk Akun Sekarang</a>
                </div>
            </div>
        </div>

        <!-- Left Side: Decorative Panel -->
        <div class="hidden md:flex flex-1 bg-emerald-500 p-16 items-center justify-center text-white relative overflow-hidden">
            <!-- Decorative Circles -->
            <div class="absolute top-0 left-0 w-64 h-64 bg-emerald-400/20 rounded-full -ml-32 -mt-32"></div>
            <div class="absolute bottom-0 right-0 w-48 h-48 bg-emerald-600/20 rounded-full -mr-24 -mb-24"></div>
            
            <div class="relative z-10 text-center">
                <div class="w-20 h-20 bg-white/20 backdrop-blur-md rounded-3xl flex items-center justify-center text-4xl mb-8 mx-auto shadow-xl">
                    🚀
                </div>
                <h2 class="text-4xl font-black mb-6 tracking-tight">Sudah Punya Akun?</h2>
                <p class="text-emerald-50 leading-relaxed mb-10 text-lg">
                    Silakan masuk untuk melanjutkan aktivitas relawan Anda dan pantau dampak kebaikan yang telah Anda berikan.
                </p>
                <a href="/login" class="inline-flex items-center gap-2 px-10 py-4 bg-white text-emerald-600 rounded-2xl font-black hover:bg-emerald-50 transition-all shadow-xl">
                    Masuk Akun
                </a>
            </div>

<style>
    /* Register Page Styling (Identical to Login) */
    .register-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 120px 20px 40px;
        background: var(--background-alt);
    }

    .register-card {
        background: white;
        border-radius: 32px;
        padding: 60px 40px;
        width: 100%;
        max-width: 480px;
        box-shadow: var(--card-shadow-hover);
        animation: slideUp 0.6s ease-out;
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .register-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 32px;
        padding: 10px 20px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 700;
        transition: var(--transition-standard);
    }

    .register-back-btn:hover {
        background: #f8fafc;
        border-color: var(--color-primary);
        color: var(--color-primary);
        transform: translateX(-4px);
    }

    .register-header {
        text-align: center;
        margin-bottom: 48px;
    }

    .register-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 24px;
        background: var(--color-lingkungan-soft);
        color: var(--color-primary);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }

    .register-header h1 {
        font-size: 2.25rem;
        font-weight: 900;
        color: var(--text-primary);
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

    .register-header p {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .register-form .input-group {
        margin-bottom: 24px;
    }

    .register-form label {
        display: block;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 8px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .register-form input,
    .register-form textarea,
    .register-form select {
        width: 100%;
        padding: 16px 20px;
        border: 2px solid #f1f5f9;
        border-radius: 16px;
        font-size: 1rem;
        font-family: inherit;
        transition: var(--transition-standard);
        background: #f8fafc;
        color: #000000;
    }

    .register-form input:focus {
        outline: none;
        border-color: var(--color-primary);
        background: white;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
    }

    .auth-btn {
        width: 100%;
        padding: 16px;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: 18px;
        font-size: 1.1rem;
        font-weight: 800;
        cursor: pointer;
        transition: var(--transition-standard);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
        margin-top: 12px;
    }

    .auth-btn:hover {
        background: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
    }

    .login-link {
        text-align: center;
        margin-top: 32px;
        padding-top: 32px;
        border-top: 1px solid #f1f5f9;
    }

    .login-link p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 16px;
    }

    .login-link a {
        color: var(--color-primary);
        text-decoration: none;
        font-weight: 800;
        transition: var(--transition-standard);
    }

    .login-link a:hover {
        color: var(--color-primary-dark);
        text-decoration: underline;
    }

    .password-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .password-toggle {
        position: absolute;
        right: 15px;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-secondary);
        padding: 5px;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .register-card {
            padding: 40px 30px;
        }
    }
</style>

<main class="register-page">
    <div class="register-card">
        <a href="/" class="register-back-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20">
                <path fill="currentColor" d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/>
            </svg>
            Kembali ke Beranda
        </a>

        <div class="register-header">
            <div class="register-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="40" height="40">
                    <path fill="currentColor" d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
            </div>

            <h1>Daftar Akun</h1>
            <p>Mulai perjalanan kebaikan Anda hari ini.</p>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div style="color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 12px; border-radius: 8px; margin-bottom: 20px; text-align: center; font-size: 14px;">
                <%= message %>
            </div>
        <% } %>

        <form action="/api/register" method="POST" class="register-form">
            <div class="input-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" placeholder="Pilih username" required>
            </div>

            <div class="input-group">
                <label for="nama_lengkap">Nama Lengkap</label>
                <input type="text" id="nama_lengkap" name="nama_lengkap" placeholder="Masukkan nama lengkap" required>
            </div>

            <div class="input-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Masukkan email Anda" required>
            </div>

            <div class="input-group">
                <label for="whatsapp">Nomor WhatsApp</label>
                <input type="tel" id="whatsapp" name="whatsapp" placeholder="Contoh: 081234567890" required>
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <div class="password-wrapper">
                    <input type="password" id="password" name="password" placeholder="Minimal 6 karakter" required minlength="6">
                    <button type="button" class="password-toggle" id="togglePassword">
                        <i class="fas fa-eye" id="eye-icon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="auth-btn">Daftar Sekarang</button>
        </form>

        <div class="login-link">
            <p>Sudah punya akun? <a href="/login">Masuk Akun</a></p>
        </div>
    </div>
</main>

<script>
    // Toggle Password Visibility
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');
    const eyeIcon = document.querySelector('#eye-icon');

    togglePassword.addEventListener('click', function () {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        eyeIcon.classList.toggle('fa-eye');
        eyeIcon.classList.toggle('fa-eye-slash');
    });

    // Handle Messages from Session
    <% if (locals.message) { %>
        const message = "<%= message %>";
        const isSuccess = message.toLowerCase().includes('berhasil') || message.toLowerCase().includes('selamat');

        Swal.fire({
            title: isSuccess ? 'Mantap!' : 'Waduh...',
            text: message,
            icon: isSuccess ? 'success' : 'error',
            confirmButtonColor: '#10b981',
            confirmButtonText: 'Oke',
            customClass: {
                popup: 'rounded-3xl',
                confirmButton: 'rounded-xl px-8 py-3 font-bold'
            }
        });
    <% } %>
</script>

<script
    if (togglePassword) {
        togglePassword.addEventListener('click', function (e) {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            
            if (type === 'text') {
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        });
    }
</script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">


<%- include('partials/footer') %>
