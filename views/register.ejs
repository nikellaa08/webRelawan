<%- include('partials/header') %>

<main class="min-h-screen flex items-center justify-center bg-slate-50 py-32 px-6">
    <div class="max-w-5xl w-full bg-white rounded-[2rem] shadow-2xl shadow-slate-200/50 overflow-hidden flex flex-col md:flex-row-reverse border border-slate-100">
        
        <!-- Right Side: Form -->
        <div class="flex-1 p-8 md:p-16">
            <div class="max-w-sm mx-auto">
                <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-emerald-600 font-bold text-sm mb-12 transition-colors group">
                    <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-1"></i> Kembali ke Beranda
                </a>

                <div class="mb-10">
                    <h1 class="text-3xl font-black text-slate-900 mb-3 tracking-tight">Daftar Akun</h1>
                    <p class="text-slate-500">Mulai perjalanan kebaikan Anda hari ini bersama Relawan Nusantara.</p>
                </div>

                <form action="/api/register" method="POST" class="space-y-5">
                    <div class="grid grid-cols-1 gap-5">
                        <div>
                            <label for="username" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Username</label>
                            <input type="text" id="username" name="username" placeholder="Pilih username" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="nama_lengkap" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Nama Lengkap</label>
                            <input type="text" id="nama_lengkap" name="nama_lengkap" placeholder="Nama lengkap sesuai KTP" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="email" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Email</label>
                            <input type="email" id="email" name="email" placeholder="contoh@email.com" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="whatsapp" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Nomor WhatsApp</label>
                            <input type="tel" id="whatsapp" name="whatsapp" placeholder="0812xxxx" required
                                class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                        </div>

                        <div>
                            <label for="password" class="block text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Password</label>
                            <div class="relative">
                                <input type="password" id="password" name="password" placeholder="Minimal 6 karakter" required minlength="6"
                                    class="w-full px-6 py-4 bg-slate-50 border-2 border-slate-50 rounded-2xl focus:bg-white focus:border-emerald-500 outline-none transition-all placeholder:text-slate-300">
                                <button type="button" id="togglePassword" class="absolute right-6 top-1/2 -translate-y-1/2 text-slate-300 hover:text-slate-500 transition-colors">
                                    <i class="fas fa-eye" id="eye-icon"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-emerald-500 text-white py-4 rounded-2xl font-bold hover:bg-emerald-600 shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 mt-4">
                        Daftar Sekarang <i class="fas fa-user-plus text-xs"></i>
                    </button>
                </form>

                <div class="mt-10 pt-10 border-t border-slate-100 text-center md:hidden">
                    <p class="text-slate-500 text-sm mb-4">Sudah punya akun?</p>
                    <a href="/login" class="text-emerald-600 font-bold hover:underline">Masuk Akun Sekarang</a>
                </div>
            </div>
        </div>

        <!-- Left Side: Decorative Panel -->
        <div class="hidden md:flex flex-1 bg-emerald-500 p-16 items-center justify-center text-white relative overflow-hidden">
            <!-- Decorative Circles -->
            <div class="absolute top-0 left-0 w-64 h-64 bg-emerald-400/20 rounded-full -ml-32 -mt-32"></div>
            <div class="absolute bottom-0 right-0 w-48 h-48 bg-emerald-600/20 rounded-full -mr-24 -mb-24"></div>
            
            <div class="relative z-10 text-center">
                <div class="w-20 h-20 bg-white/20 backdrop-blur-md rounded-3xl flex items-center justify-center text-4xl mb-8 mx-auto shadow-xl">
                    🚀
                </div>
                <h2 class="text-4xl font-black mb-6 tracking-tight">Sudah Punya Akun?</h2>
                <p class="text-emerald-50 leading-relaxed mb-10 text-lg">
                    Silakan masuk untuk melanjutkan aktivitas relawan Anda dan pantau dampak kebaikan yang telah Anda berikan.
                </p>
                <a href="/login" class="inline-flex items-center gap-2 px-10 py-4 bg-white text-emerald-600 rounded-2xl font-black hover:bg-emerald-50 transition-all shadow-xl">
                    Masuk Akun
                </a>
            </div>
        </div>
    </div>
</main>

<script>
    // Toggle Password Visibility
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');
    const eyeIcon = document.querySelector('#eye-icon');

    togglePassword.addEventListener('click', function () {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        eyeIcon.classList.toggle('fa-eye');
        eyeIcon.classList.toggle('fa-eye-slash');
    });

    // Handle Messages from Session
    <% if (locals.message) { %>
        const message = "<%= message %>";
        const isSuccess = message.toLowerCase().includes('berhasil') || message.toLowerCase().includes('selamat');

        Swal.fire({
            title: isSuccess ? 'Mantap!' : 'Waduh...',
            text: message,
            icon: isSuccess ? 'success' : 'error',
            confirmButtonColor: '#10b981',
            confirmButtonText: 'Oke',
            customClass: {
                popup: 'rounded-3xl',
                confirmButton: 'rounded-xl px-8 py-3 font-bold'
            }
        });
    <% } %>
</script>

<%- include('partials/footer') %>
