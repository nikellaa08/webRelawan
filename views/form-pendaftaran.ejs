    <!-- Notifikasi Sukses -->
    <div id="successNotification" class="success-notification">
        <div class="icon">🎉</div>
        <div class="message">
            <h3>Pendaftaran Berhasil!</h3>
            <p>Terima kasih telah mendaftar. Tim kami akan menghubungi Anda segera.</p>
        </div>
