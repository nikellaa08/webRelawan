<%- include('partials/header') %>

    <style>
        .container-pakaian {
            max-width: 900px;
            margin: 120px auto 60px;
            padding: 20px;
        }
        .hero-image-pakaian {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }
        .detail-box-pakaian {
            background: white;
            padding: 40px;
            border-radius: 30px;
            margin-top: -50px;
            position: relative;
            z-index: 10;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: 1px solid #eee;
        }
        .info-list-pakaian {
            list-style: none;
            padding: 0;
            margin: 30px 0;
        }
        .info-list-pakaian li {
            padding: 15px 0;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            justify-content: space-between;
        }
        .info-label-pakaian {
            font-weight: 700;
            color: #667eea;
        }
        .btn-donasi-pakaian {
            display: block; width: 100%; padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; border-radius: 15px;
            font-weight: 800; font-size: 1.1rem; cursor: pointer; transition: 0.3s;
        }
        .btn-donasi-pakaian:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(118, 75, 162, 0.4); }
    </style>

    <div class="container-pakaian">
        <img src="https://images.unsplash.com/photo-1517677208171-0bc6725a3e60?q=80&w=2070&auto=format&fit=crop" class="hero-image-pakaian" alt="Donasi Pakaian">
        
        <div class="detail-box-pakaian">
            <h1>Program Donasi Pakaian</h1>
            <p style="color: #666; line-height: 1.8; margin-top: 15px;">Salurkan pakaian layak pakaimu untuk meringankan beban saudara-saudara kita yang membutuhkan di Panti Asuhan dan daerah terdampak bencana.</p>
            
            <ul class="info-list-pakaian">
                <li><span class="info-label-pakaian">📍 Lokasi Penyaluran</span> <span>Korban Bencana / Panti</span></li>
                <li><span class="info-label-pakaian">👕 Jenis Pakaian</span> <span>Anak, Dewasa, Seragam</span></li>
                <li><span class="info-label-pakaian">✨ Kondisi</span> <span>Layak Pakai / Baru</span></li>
                <li><span class="info-label-pakaian">🏅 Reward</span> <span>30 Koin + Lencana</span></li>
            </ul>

            <button onclick="window.location.href='/donation-form'" class="btn-donasi-pakaian">Donasi Sekarang</button>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2026 Relawan Nusantara. Semua Hak Dilindungi.</p>
    </footer>
</body>
</html>
