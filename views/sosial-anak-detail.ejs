<%- include('partials/header') %>

    <style>
        .container-sosial-detail {
            max-width: 1000px;
            margin: 120px auto 60px;
            padding: 20px;
        }
        .detail-card-sosial {
            background: white;
            border-radius: 30px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
        }
        .detail-image-sosial {
            width: 100%;
            height: 450px;
            object-fit: cover;
        }
        .detail-content-sosial {
            padding: 50px;
        }
        .detail-info-grid-sosial {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin: 40px 0;
        }
        .detail-info-item-sosial {
            padding: 20px;
            background: #f8f9fa;
            border-radius: 20px;
            border-left: 5px solid #764ba2;
        }
        .detail-info-item-sosial h4 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 0.9rem;
            text-transform: uppercase;
        }
        .detail-info-item-sosial p {
            font-weight: 700;
            color: #333;
            margin: 0;
        }
        .btn-daftar-sosial {
            display: block; width: 100%; padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; border-radius: 15px;
            font-weight: 800; font-size: 1.1rem; cursor: pointer; transition: 0.3s;
        }
        .btn-daftar-sosial:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(118, 75, 162, 0.4); }
    </style>

    <div class="container-sosial-detail">
        <div class="detail-card-sosial">
            <img src="https://images.unsplash.com/photo-1505242768132-c958a4e4e601?q=80&w=2070&auto=format&fit=crop" alt="Kegiatan Sosial Anak" class="detail-image-sosial">
            <div class="detail-content-sosial">
                <h1>Kunjungan Panti Asuhan</h1>
                <p style="color: #666; line-height: 1.8; margin-top: 20px;">Menghadirkan kehangatan keluarga melalui pendidikan, pendampingan, dan kasih sayang. Relawan berperan sebagai kakak dan guru bagi anak-anak panti.</p>

                <div class="detail-info-grid-sosial">
                    <div class="detail-info-item-sosial">
                        <h4>Jadwal</h4>
                        <p>Minggu, 09:00 - 11:00 WIB</p>
                    </div>
                    <div class="detail-info-item-sosial">
                        <h4>Kuota</h4>
                        <p>30 Relawan</p>
                    </div>
                    <div class="detail-info-item-sosial">
                        <h4>Tugas</h4>
                        <p>Mengajar & Bermain</p>
                    </div>
                    <div class="detail-info-item-sosial">
                        <h4>Reward</h4>
                        <p>35 Koin</p>
                    </div>
                </div>

                <button onclick="window.location.href='/kunjungan-panti-asuhan-form'" class="btn-daftar-sosial">Daftar Sekarang</button>
            </div>
        </div>
    </div>

    <footer class="footer">
        <p>&copy; 2026 Relawan Nusantara. Semua Hak Dilindungi.</p>
    </footer>
</body>
</html>
