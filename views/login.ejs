=======
<style>
    /* Login Page Styling */
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 120px 20px 40px;
        background: var(--background-alt);
    }

    .login-card {
        background: white;
        border-radius: 32px;
        padding: 60px 40px;
        width: 100%;
        max-width: 480px;
        box-shadow: var(--card-shadow-hover);
        animation: slideUp 0.6s ease-out;
        border: 1px solid rgba(0, 0, 0, 0.02);
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 32px;
        padding: 10px 20px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 700;
        transition: var(--transition-standard);
    }

    .login-back-btn:hover {
        background: #f8fafc;
        border-color: var(--color-primary);
        color: var(--color-primary);
        transform: translateX(-4px);
    }

    .login-header {
        text-align: center;
        margin-bottom: 48px;
    }

    .login-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 24px;
        background: var(--color-lingkungan-soft);
        color: var(--color-primary);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }

    .login-header h1 {
        font-size: 2.25rem;
        font-weight: 900;
        color: var(--text-primary);
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

    .login-header p {
        color: var(--text-secondary);
        font-size: 1rem;
    }

    .login-form .input-group {
        margin-bottom: 28px;
    }

    .login-form label {
        display: block;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 10px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .login-form input[type="email"],
    .login-form input[type="password"] {
        width: 100%;
        padding: 16px 20px;
        border: 2px solid #f1f5f9;
        border-radius: 16px;
        font-size: 1rem;
        font-family: inherit;
        transition: var(--transition-standard);
        background: #f8fafc;
    }

    .login-form input:focus {
        outline: none;
        border-color: var(--color-primary);
        background: white;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
    }

    .login-btn {
        width: 100%;
        padding: 16px;
        background: var(--color-primary);
        color: white;
        border: none;
        border-radius: 18px;
        font-size: 1.1rem;
        font-weight: 800;
        cursor: pointer;
        transition: var(--transition-standard);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
        margin-top: 12px;
    }

    .login-btn:hover {
        background: var(--color-primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
    }

    .register-link {
        text-align: center;
        margin-top: 32px;
        padding-top: 32px;
        border-top: 1px solid #f1f5f9;
    }

    .register-link p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 16px;
    }

    .register-link a {
        color: var(--color-primary);
        text-decoration: none;
        font-weight: 800;
        transition: var(--transition-standard);
    }

    .register-link a:hover {
        color: var(--color-primary-dark);
        text-decoration: underline;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .login-card {
            padding: 40px 30px;
        }

        .login-header h1 {
            font-size: 1.7rem;
        }

        .login-icon {
            width: 70px;
            height: 70px;
        }

        .login-icon svg {
            width: 35px;
            height: 35px;
        }

        .login-back-btn {
            font-size: 0.85rem;
            padding: 6px 12px;
        }
    }
</style>

<main class="login-page">
    <div class="login-card">
        <a href="/" class="login-back-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/>
            </svg>
            Kembali ke Beranda
        </a>

        <div class="login-header">
            <div class="login-icon">
                <!-- User Account Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                </svg>

            </div>

            <% if (typeof message !== 'undefined' && message) { %>
                <div style="color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 12px; border-radius: 8px; margin-bottom: 20px; text-align: center; font-size: 14px;">
                    <%= message %>
                </div>
            <% } %>

            <form action="/api/login" method="POST" class="auth-form">
                <div class="input-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" placeholder="Masukkan username Anda" required>
                </div>

                <div class="input-group">
                    <label for="password">Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="password" name="password" placeholder="Masukkan password Anda" required>
                        <button type="button" class="password-toggle" id="togglePassword">
                            <i class="fas fa-eye" id="eye-icon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="auth-btn">Masuk Sekarang</button>
            </form>
        </div>
    </div>

    <!-- Sisi Kanan: Panel Hijau -->
    <div class="auth-panel-side">
        <div class="panel-content">
            <h2>Halo, Teman!</h2>
            <p>Belum punya akun? Mari bergabung menjadi bagian dari Relawan Nusantara sekarang juga.</p>
            <a href="/register" class="panel-btn">Daftar Akun</a>
        </div>
    </div>
</main>

<script>
    const message = "<%= message %>";
    
    if (message && message !== "null" && message !== "") {
        const isSuccess = message.toLowerCase().includes('berhasil') || message.toLowerCase().includes('selamat');

        Swal.fire({
            title: isSuccess ? 'Mantap!' : 'Waduh...',
            text: message,
            icon: isSuccess ? 'success' : 'error',
            showConfirmButton: !isSuccess,
            timer: isSuccess ? 3000 : null,
            timerProgressBar: isSuccess,
            confirmButtonColor: '#16a34a', // Hijau Relawan
            iconColor: isSuccess ? '#16a34a' : '#ef4444',
            showClass: {
                popup: 'animate__animated animate__fadeInDown'
            },
            hideClass: {
                popup: 'animate__animated animate__fadeOutUp'
            }
        });
    }
</script>


