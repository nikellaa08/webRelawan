<%- include('partials/header') %>

    <style>
        :root {
            --primary: #6366f1;
            --secondary: #a855f7;
            --accent: #3b82f6;
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
            --text-main: #ffffff;
            --text-dim: rgba(255, 255, 255, 0.7);
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow-x: hidden;
            color: var(--text-main);
            padding-top: 100px; /* Ruang untuk navbar fixed */
        }

        /* Ambient Background Blobs */
        .blob {
            position: fixed;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
            filter: blur(80px);
            opacity: 0.4;
            z-index: -1;
            animation: move 20s infinite alternate;
        }

        .blob-2 {
            right: -100px;
            top: -100px;
            background: radial-gradient(circle, var(--secondary) 0%, transparent 70%);
            animation-delay: -5s;
        }

        @keyframes move {
            from { transform: translate(0, 0); }
            to { transform: translate(100px, 100px); }
        }

        .container-premium {
            width: 100%;
            max-width: 500px;
            z-index: 10;
        }

        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .header-premium {
            text-align: center;
            margin-bottom: 30px;
        }

        .header-premium h1 {
            font-size: 2rem;
            font-weight: 700;
            background: linear-gradient(to right, #fff, var(--text-dim));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        .header-premium p {
            color: var(--text-dim);
            font-size: 0.95rem;
        }

        .form-group-premium {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group-premium label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-dim);
        }

        .form-group-premium input, .form-group-premium textarea {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: #fff;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-group-premium input:focus, .form-group-premium textarea:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
        }

        /* Admin Toggle Switch */
        .switch-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.05);
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid var(--glass-border);
        }

        .switch-label {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 24px;
        }

        .switch input { opacity: 0; width: 0; height: 0; }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(255,255,255,0.1);
            transition: .4s;
            border-radius: 24px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px; width: 18px;
            left: 3px; bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        input:checked + .slider { background-color: var(--primary); }
        input:checked + .slider:before { transform: translateX(24px); }

        /* Admin Key Animation */
        #admin-key-group {
            max-height: 0;
            overflow: hidden;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
        }

        #admin-key-group.active {
            max-height: 100px;
            opacity: 1;
            margin-bottom: 20px;
        }

        /* Submit Button */
        .submit-btn-premium {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #6366f1 0%, #3b82f6 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            margin-top: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .submit-btn-premium:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px -10px rgba(99, 102, 241, 0.5);
        }

        .footer-text-premium {
            text-align: center;
            margin-top: 24px;
            font-size: 0.9rem;
            color: var(--text-dim);
        }

        .footer-text-premium a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .alert-premium {
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #f87171;
            text-align: center;
        }
    </style>

    <div class="blob"></div>
    <div class="blob blob-2"></div>

    <div class="container-premium">
        <div class="glass-card">
            <div class="header-premium">
                <h1>Bergabunglah</h1>
                <p>Mulai perjalanan sosialmu hari ini</p>
            </div>

            <% if (locals.message) { %>
                <div class="alert-premium"><%= message %></div>
            <% } %>

            <form action="/daftar" method="POST">
                <div class="form-group-premium">
                    <label for="username">Nama Lengkap</label>
                    <input type="text" id="username" name="username" placeholder="John Doe" required>
                </div>

                <div class="form-group-premium">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="hello@example.com" required>
                </div>

                <div class="form-group-premium">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                </div>

                <div class="switch-container">
                    <span class="switch-label">Daftar sebagai Admin?</span>
                    <label class="switch">
                        <input type="checkbox" id="admin-toggle">
                        <span class="slider"></span>
                    </label>
                </div>

                <div id="admin-key-group" class="form-group-premium">
                    <label for="admin_key">Admin Secret Key</label>
                    <input type="password" id="admin_key" name="admin_key" placeholder="Masukkan kode akses admin">
                </div>

                <div class="form-group-premium">
                    <label for="keahlian">Keahlian</label>
                    <input type="text" id="keahlian" name="keahlian" placeholder="Contoh: Digital Marketing, Medis">
                </div>

                <button type="submit" class="submit-btn-premium">
                    <span>Buat Akun Sekarang</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </button>
            </form>

            <p class="footer-text-premium">
                Sudah punya akun? <a href="/login">Masuk di sini</a>
            </p>
        </div>
    </div>

    <script>
        // Admin Toggle Logic
        const toggle = document.getElementById('admin-toggle');
        const adminGroup = document.getElementById('admin-key-group');
        const adminInput = document.getElementById('admin_key');

        toggle.addEventListener('change', function() {
            if(this.checked) {
                adminGroup.classList.add('active');
                adminInput.required = true;
            } else {
                adminGroup.classList.remove('active');
                adminInput.required = false;
                adminInput.value = '';
            }
        });
    </script>
</body>
</html>
