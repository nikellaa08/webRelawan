<%- include('partials/header') %>

<main class="registration-form-page" style="padding-top: 100px; background: #f8fafc; min-height: 100vh;">
    <div class="container mx-auto px-4 max-w-2xl">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-emerald-100">
            <div class="bg-emerald-600 p-8 text-white">
                <h1 class="text-2xl font-bold mb-2">Form Pendaftaran Kegiatan</h1>
                <p class="opacity-90">Program: <span class="font-semibold"><%= programName %></span></p>
            </div>

            <div class="p-8">
                <style>
                    #formPendaftaran input, 
                    #formPendaftaran textarea, 
                    #formPendaftaran select {
                        color: #000000 !important;
                    }
                </style>
                <form id="formPendaftaran" class="space-y-6">
                    <input type="hidden" name="program_name" value="<%= programName %>">
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Nama Lengkap</label>
                        <input type="text" name="nama" value="<%= user ? user.name : '' %>" 
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition-all"
                            placeholder="Masukkan nama lengkap" required>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Alamat Email</label>
                        <input type="email" name="email" value="<%= user ? user.email : '' %>" 
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition-all"
                            placeholder="Masukkan email aktif" required>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Nomor WhatsApp</label>
                        <input type="tel" name="whatsapp" value="<%= user ? user.whatsapp || '' : '' %>" 
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition-all"
                            placeholder="Contoh: 081234567890" required>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Pilihan Jadwal</label>
                        <select name="jadwal" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition-all cursor-pointer" required>
                            <option value="" disabled selected>Pilih jadwal kegiatan</option>
                            <option value="Sesi Pagi (08:00 - 12:00)">Sesi Pagi (08:00 - 12:00)</option>
                            <option value="Sesi Siang (13:00 - 17:00)">Sesi Siang (13:00 - 17:00)</option>
                            <option value="Full Day (08:00 - 17:00)">Full Day (08:00 - 17:00)</option>
                            <option value="Fleksibel">Fleksibel</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Motivasi Ikut</label>
                        <textarea name="motivasi" rows="4" 
                            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none transition-all"
                            placeholder="Ceritakan motivasi Anda mengikuti kegiatan ini..." required></textarea>
                    </div>

                    <button type="submit" 
                        class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 rounded-xl shadow-lg shadow-emerald-200 transform transition hover:-translate-y-1 active:translate-y-0">
                        Kirim Pendaftaran
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>

<script>
document.getElementById('formPendaftaran').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
        const response = await fetch('/api/daftar-kegiatan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
            Swal.fire({
                title: 'Pendaftaran Berhasil!',
                text: 'Pendaftaran Berhasil Dikirim!',
                icon: 'success',
                confirmButtonColor: '#16a34a',
                confirmButtonText: 'Mantap!'
            }).then(() => { window.location.href = '/'; });
        } else {
            Swal.fire({ title: 'Gagal!', text: result.message || 'Terjadi kesalahan.', icon: 'error', confirmButtonColor: '#16a34a' });
        }
    } catch (error) {
        Swal.fire({ title: 'Error!', text: 'Terjadi kesalahan koneksi.', icon: 'error', confirmButtonColor: '#16a34a' });
    }
});
</script>

<%- include('partials/footer') %>
