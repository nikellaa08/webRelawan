<%- include('partials/header') %>

    <style>
        .form-container-donasi {
            max-width: 500px;
            margin: 120px auto 60px;
            padding: 40px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .form-container-donasi h1 {
            text-align: center;
            margin-bottom: 30px;
            color: #764ba2;
        }
        .form-group-donasi {
            margin-bottom: 20px;
        }
        .form-group-donasi label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }
        .form-group-donasi input[type="text"],
        .form-group-donasi input[type="email"],
        .form-group-donasi input[type="tel"],
        .form-group-donasi input[type="number"],
        .form-group-donasi select,
        .form-group-donasi textarea,
        .form-group-donasi input[type="file"] {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ddd;
            font-family: inherit;
            font-size: 1rem;
            box-sizing: border-box;
        }
        .form-group-donasi textarea {
            resize: vertical;
            min-height: 100px;
        }
        .form-group-donasi .radio-group-donasi {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }
        .form-group-donasi .radio-group-donasi label {
            display: flex;
            align-items: center;
            font-weight: 400;
            margin-bottom: 0;
        }
        .form-group-donasi .radio-group-donasi input[type="radio"] {
            width: auto;
            margin-right: 8px;
        }
        .btn-donasi-submit {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .btn-donasi-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(118, 75, 162, 0.4);
        }
    </style>

    <!-- DONATION FORM -->
    <section class="section">
        <div class="form-container-donasi">
            <h1>Donasi Pakaian<br><small style="font-weight: 400; font-size: 0.6em;">untuk Memberi Kehangatan</small></h1>
            <form id="clothDonationForm">
                <div class="form-group-donasi">
                    <label for="donorName">Nama Donatur:</label>
                    <input type="text" id="donorName" name="donorName" required>
                </div>
                <div class="form-group-donasi">
                    <label for="contact">No. HP / Email:</label>
                    <input type="text" id="contact" name="contact" required>
                </div>
                <div class="form-group-donasi">
                    <label for="clothType">Jenis Pakaian:</label>
                    <select id="clothType" name="clothType" required>
                        <option value="">Pilih Jenis Pakaian</option>
                        <option value="pakaian">Pakaian</option>
                        <option value="celana">Celana</option>
                        <option value="lainnya">Custom / Pilih Sendiri</option>
                    </select>
                </div>
                <div class="form-group-donasi">
                    <label for="clothSize">Ukuran:</label>
                    <select id="clothSize" name="clothSize" required>
                        <option value="">Pilih Ukuran</option>
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                        <option value="campur">Campur</option>
                    </select>
                </div>
                <div class="form-group-donasi">
                    <label for="quantity">Jumlah Pakaian:</label>
                    <input type="number" id="quantity" name="quantity" min="1" required>
                </div>
                <div class="form-group-donasi">
                    <label for="condition">Kondisi:</label>
                    <select id="condition" name="condition" required>
                        <option value="">Pilih Kondisi</option>
                        <option value="sangat_baik">Sangat Baik</option>
                        <option value="baik">Baik</option>
                        <option value="cukup">Cukup</option>
                    </select>
                </div>
                <div class="form-group-donasi">
                    <label for="clothPhoto">Foto Pakaian (Upload):</label>
                    <input type="file" id="clothPhoto" name="clothPhoto" accept="image/*">
                </div>
                <div class="form-group-donasi">
                    <label>Pilih Metode:</label>
                    <div class="radio-group-donasi">
                        <label><input type="radio" name="deliveryMethod" value="dijemput"> Dijemput Relawan</label>
                        <label><input type="radio" name="deliveryMethod" value="drop_point"> Antar ke Drop Point</label>
                    </div>
                </div>
                <div class="form-group-donasi">
                    <label for="pickupAddress">Alamat Penjemputan:</label>
                    <textarea id="pickupAddress" name="pickupAddress"></textarea>
                </div>
                <div class="form-group-donasi">
                    <label for="notes">Catatan Tambahan:</label>
                    <textarea id="notes" name="notes"></textarea>
                </div>
                
                <button type="submit" class="btn-donasi-submit">Donasikan Sekarang</button>
            </form>
        </div>
    </section>

    <footer class="footer">
        <p>&copy; 2026 Relawan Nusantara. Semua Hak Dilindungi.</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('clothDonationForm');
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                alert('Terima kasih! Donasi Anda telah tercatat.');
                window.location.href = '/sosial-kemanusiaan';
            });
        });
    </script>
</body>
</html>
