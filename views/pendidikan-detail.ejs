<%- include('partials/header') %>

    <style>
        :root {
            --bg: #010409;
            --primary: #00f2ff;
            --secondary: #7000ff;
            --glass: rgba(255, 255, 255, 0.03);
        }

        body { background: var(--bg); color: white; font-family: 'Plus Jakarta Sans', sans-serif; margin: 0; }
        
        .container-edu { max-width: 900px; margin: 120px auto 60px; padding: 20px; }
        .back-btn-edu { color: var(--primary); text-decoration: none; font-weight: 600; display: inline-block; margin-bottom: 20px; }
        
        .hero-section-edu {
            position: relative; border-radius: 30px; overflow: hidden;
            height: 400px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }
        .hero-section-edu img { width: 100%; height: 100%; object-fit: cover; }
        .hero-overlay-edu {
            position: absolute; bottom: 0; left: 0; width: 100%; padding: 40px;
            background: linear-gradient(to top, rgba(1,4,9,1), transparent);
        }

        .content-card-edu {
            background: var(--glass); border: 1px solid rgba(255,255,255,0.05);
            padding: 40px; border-radius: 30px; margin-top: 20px; backdrop-filter: blur(10px);
        }
        .info-grid-edu {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 30px;
        }
        .info-item-edu {
            background: rgba(255,255,255,0.02); padding: 20px; border-radius: 20px;
            border-left: 4px solid var(--primary);
        }
        .info-item-edu label { display: block; color: #8b949e; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 5px; }
        .info-item-edu span { font-weight: 700; font-size: 1.1rem; }

        .btn-action-edu {
            display: block; width: 100%; padding: 20px; margin-top: 40px;
            border-radius: 20px; border: none; font-weight: 800; font-size: 1.1rem;
            cursor: pointer; transition: 0.3s;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            color: white; box-shadow: 0 10px 20px rgba(112, 0, 255, 0.3);
        }
        .btn-action-edu:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0, 242, 255, 0.4); }
    </style>

    <div class="container-edu">
        <a href="/pendidikan" class="back-btn-edu">← Kembali ke Daftar Program</a>

        <div class="hero-section-edu">
            <img src="<%= detail.img %>" alt="Hero Image">
            <div class="hero-overlay-edu">
                <h1 style="font-size: 2.5rem; font-weight: 800;"><%= detail.title %></h1>
            </div>
        </div>

        <div class="content-card-edu">
            <p style="color: #8b949e; line-height: 1.8; font-size: 1.1rem;"><%= detail.desc %></p>

            <div class="info-grid-edu">
                <div class="info-item-edu">
                    <label>📅 Jadwal</label>
                    <span><%= detail.jadwal %></span>
                </div>
                <div class="info-item-edu">
                    <label>👥 Kuota</label>
                    <span><%= detail.kuota %></span>
                </div>
                <div class="info-item-edu">
                    <label>📝 Tugas</label>
                    <span><%= detail.tugas %></span>
                </div>
                <div class="info-item-edu">
                    <label>🪙 Reward</label>
                    <span style="color: #ffda44;"><%= detail.reward %> Koin</span>
                </div>
            </div>

            <button id="btnAmbilMisi" class="btn-action-edu">Daftar & Ambil Misi Sekarang</button>
        </div>
    </div>

    <script>
        document.getElementById('btnAmbilMisi').addEventListener('click', function() {
            const rewardMisi = parseInt("<%= detail.reward %>");
            const namaMisi = "<%= detail.title %>";
            alert(`Selamat! 🎉\nKamu berhasil mendaftar misi: ${namaMisi}\nReward +${rewardMisi} Koin telah ditambahkan.`);
            window.location.href = "/pendidikan";
        });
    </script>
</body>
</html>
