<%- include('partials/header') %>

<main class="pt-24 min-h-screen bg-slate-50">
    <section class="py-16">
        <div class="container mx-auto px-6">
            <!-- Breadcrumb-like back button -->
            <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-blue-600 font-bold text-sm mb-8 transition-colors group">
                <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-1"></i> Kembali ke Beranda
            </a>

            <div class="max-w-4xl mb-16">
                <h1 class="text-4xl lg:text-5xl font-black text-slate-900 mb-6 tracking-tight">
                    Program Relawan <span class="text-blue-600">Pendidikan</span>
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Pendidikan adalah kunci untuk masa depan yang lebih baik. Bersama Relawan Nusantara, mari berikan kesempatan pendidikan yang merata dan berkualitas bagi setiap anak bangsa.
                </p>
                <div class="mt-4 p-4 bg-blue-50 rounded-2xl border border-blue-100">
                    <p class="text-blue-800 font-medium">
                        Mari gerakkan hati dan tangan untuk: <strong>mengajar, mendampingi, dan menginspirasi</strong>. Cerdaskan bangsa, sejahtera bersama!
                    </p>
                </div>
            </div>

            <%
            const educationPrograms = [
                {
                    emoji: "🎒",
                    title: "Donasi Perlengkapan Sekolah",
                    slug: "donasi-perlengkapan",
                    cta: "Satu pensil, satu buku, satu harapan. Donasikan perlengkapan sekolah untuk anak-anak yang membutuhkan.",
                    schedule: "Sesuai jadwal pengumpulan",
                    location: "Sekolah / Panti Asuhan",
                    target: "Anak-anak SD, SMP, SMA",
                    reward: "Koin + Lencana Donatur"
                },
                {
                    emoji: "🚌",
                    title: "Taman Baca Keliling",
                    slug: "taman-baca-keliling",
                    cta: "Membawa jendela dunia lebih dekat kepada mereka. Mari bergerak bersama untuk menebar minat baca di pelosok negeri.",
                    schedule: "Setiap minggu / sesuai rute",
                    location: "Desa / Sekolah terpencil",
                    target: "Anak-anak SD – SMA/SMK",
                    reward: "Koin + Lencana Relawan Literasi"
                },
                {
                    emoji: "👩‍🏫",
                    title: "Bimbingan Belajar Gratis",
                    slug: "bimbingan-belajar",
                    cta: "Bantu anak-anak meraih cita-cita. Bergabunglah sebagai pengajar atau pendamping bimbingan belajar gratis.",
                    schedule: "Sesuai jadwal yang ditentukan",
                    location: "Pusat Komunitas / Online",
                    target: "Matematika, Bahasa Inggris, IPA",
                    reward: "Koin + Lencana Pengajar"
                },
                {
                    emoji: "🏗️",
                    title: "Renovasi Fasilitas Pendidikan",
                    slug: "renovasi-fasilitas",
                    cta: "Lingkungan belajar yang nyaman meningkatkan semangat. Bantu wujudkan fasilitas pendidikan yang layak.",
                    schedule: "Sesuai jadwal proyek",
                    location: "Sekolah Rusak / Minim Fasilitas",
                    target: "Umum / Profesional",
                    reward: "Koin + Lencana Pembangun"
                }
            ];
            %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% educationPrograms.forEach(function(item, index) { %>
                <div class="standard-card flex flex-col h-full group hover:border-blue-200 bg-white p-8 rounded-3xl shadow-sm border border-slate-100 transition-all hover:shadow-xl">
                    <div class="flex items-start justify-between mb-8">
                        <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center text-3xl transition-transform group-hover:scale-110">
                            <%= item.emoji %>
                        </div>
                        <span class="px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-[10px] font-bold uppercase tracking-wider">Pendidikan</span>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-blue-600 transition-colors"><%= item.title %></h3>
                    <p class="text-slate-500 italic mb-8 flex-grow">"<%= item.cta %>"</p>

                    <div class="space-y-4 mb-10">
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-calendar-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Waktu</p>
                                <p class="text-slate-700 font-bold"><%= item.schedule %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-map-marker-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Lokasi</p>
                                <p class="text-slate-700 font-bold"><%= item.location %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-users text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Target</p>
                                <p class="text-slate-700 font-bold"><%= item.target %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-500">
                                <i class="fas fa-award text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Reward</p>
                                <p class="text-slate-700 font-bold"><%= item.reward %></p>
                            </div>
                        </div>
                    </div>

                    <a href="/daftar-pendidikan/<%= item.slug %>" class="btn-main bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-600/20 w-full flex items-center justify-center py-4 rounded-2xl font-bold transition-all">
                        Ikuti Sekarang <i class="fas fa-arrow-right ml-2 text-xs"></i>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
