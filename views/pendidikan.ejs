<%- include('partials/header') %>

<main class="pt-24 min-h-screen bg-slate-50">
    <section class="py-16">
        <div class="container mx-auto px-6">
            <!-- Breadcrumb-like back button -->
            <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-blue-600 font-bold text-sm mb-8 transition-colors group">
                <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-1"></i> Kembali ke Beranda
            </a>

            <div class="max-w-4xl mb-16">
                <h1 class="text-4xl lg:text-5xl font-black text-slate-900 mb-6 tracking-tight">
                    Program Relawan <span class="text-blue-600">Pendidikan</span>
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Pendidikan adalah kunci untuk masa depan yang lebih baik. Bersama Relawan Nusantara, mari berikan kesempatan pendidikan yang merata dan berkualitas bagi setiap anak bangsa.
                </p>
                <div class="mt-4 p-4 bg-blue-50 rounded-2xl border border-blue-100">
                    <p class="text-blue-800 font-medium">
                        Mari gerakkan hati dan tangan untuk: <strong>mengajar, mendampingi, dan menginspirasi</strong>. Cerdaskan bangsa, sejahtera bersama!
                    </p>
                </div>
            </div>

            <%
            const educationPrograms = [
                {
                    emoji: "🎒",
                    title: "Donasi Perlengkapan Sekolah",
                    slug: "donasi-perlengkapan",
                    cta: "Satu pensil, satu buku, satu harapan. Donasikan perlengkapan sekolah untuk anak-anak yang membutuhkan.",
                    schedule: "Sesuai jadwal pengumpulan",
                    location: "Sekolah / Panti Asuhan",
                    target: "Anak-anak SD, SMP, SMA",
                    reward: "Koin + Lencana Donatur"
                },
                {
                    emoji: "🚌",
                    title: "Taman Baca Keliling",
                    slug: "taman-baca-keliling",
                    cta: "Membawa jendela dunia lebih dekat kepada mereka. Mari bergerak bersama untuk menebar minat baca di pelosok negeri.",
                    schedule: "Setiap minggu / sesuai rute",
                    location: "Desa / Sekolah terpencil",
                    target: "Anak-anak SD – SMA/SMK",
                    reward: "Koin + Lencana Relawan Literasi"
