<%- include('partials/header') %>

<main class="pt-24 min-h-screen bg-slate-50">
    <section class="py-16">
        <div class="container mx-auto px-6">
            <!-- Breadcrumb-like back button -->
            <a href="/" class="inline-flex items-center gap-2 text-slate-400 hover:text-rose-600 font-bold text-sm mb-8 transition-colors group">
                <i class="fas fa-arrow-left transition-transform group-hover:-translate-x-1"></i> Kembali ke Beranda
            </a>

            <div class="max-w-4xl mb-16">
                <h1 class="text-4xl lg:text-5xl font-black text-slate-900 mb-6 tracking-tight">
                    Program Relawan <span class="text-rose-600">Kesehatan</span>
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed">
                    Kesehatan adalah hak setiap individu. Bersama Relawan Nusantara, mari wujudkan akses kesehatan yang merata. Setiap aksi kecil kita membawa dampak besar bagi kemanusiaan.
                </p>
                <div class="mt-4 p-4 bg-rose-50 rounded-2xl border border-rose-100">
                    <p class="text-rose-800 font-medium">
                        Layanan medis, edukasi gizi, dan dukungan kesehatan mental: <strong>melayani, mengedukasi, dan menyembuhkan</strong> untuk Indonesia yang lebih sehat.
                    </p>
                </div>
            </div>

            <%
            const healthPrograms = [
                {
                    emoji: "🩺",
                    title: "Pemeriksaan Kesehatan Gratis",
                    slug: "pemeriksaan-gratis",
                    cta: "Akses kesehatan dasar adalah hak semua. Bergabunglah untuk memberikan pemeriksaan gratis bagi masyarakat kurang mampu.",
                    schedule: "Sesuai jadwal rutin",
                    location: "Posko Kesehatan Desa",
                    target: "Dokter, Perawat, Umum",
                    reward: "Koin + Lencana Kesehatan"
                },
                {
                    emoji: "🩸",
                    title: "Donor Darah Nasional",
                    slug: "donor-darah",
                    cta: "Setetes darahmu menyelamatkan nyawa. Ikuti aksi donor darah rutin kami dan jadilah pahlawan kemanusiaan!",
                    schedule: "Sesuai jadwal PMI",
                    location: "PMI Setempat / Mall",
                    target: "Usia 17-60 tahun",
                    reward: "Koin + Lencana Donor"
                },
                {
                    emoji: "🍎",
                    title: "Sosialisasi Gizi Anak",
                    slug: "gizi-anak",
                    cta: "Masa depan bangsa dimulai dari gizi yang baik. Edukasi orang tua tentang nutrisi penting untuk mencegah stunting.",
                    schedule: "Setiap Akhir Bulan",
                    location: "Posyandu Desa Binaan",
                    target: "Ibu Hamil & Balita",
                    reward: "Koin + Lencana Edukasi"
                },
                {
                    emoji: "🧠",
                    title: "Support System Mental Health",
                    slug: "mental-health",
                    cta: "Mental yang sehat adalah pondasi kebahagiaan. Saling mendukung untuk kesehatan jiwa yang lebih baik bagi semua.",
                    schedule: "Terjadwal / Online",
                    location: "Pusat Komunitas / Zoom",
                    target: "Psikolog & Konselor",
                    reward: "Koin + Lencana Peduli"
                }
            ];
            %>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% healthPrograms.forEach(function(item, index) { %>
                <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-rose-200 transition-all flex flex-col h-full group">
                    <div class="flex items-start justify-between mb-8">
                        <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center text-3xl transition-transform group-hover:scale-110">
                            <%= item.emoji %>
                        </div>
                        <span class="px-3 py-1 bg-rose-50 text-rose-600 rounded-full text-[10px] font-bold uppercase tracking-wider">Kesehatan</span>
                    </div>
                    
                    <h3 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-rose-600 transition-colors"><%= item.title %></h3>
                    <p class="text-slate-500 italic mb-8 flex-grow">"<%= item.cta %>"</p>

                    <div class="space-y-4 mb-10">
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-calendar-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Waktu</p>
                                <p class="text-slate-700 font-bold"><%= item.schedule %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-map-marker-alt text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Lokasi</p>
                                <p class="text-slate-700 font-bold"><%= item.location %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-users text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Target</p>
                                <p class="text-slate-700 font-bold"><%= item.target %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-500">
                                <i class="fas fa-award text-xs"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Reward</p>
                                <p class="text-slate-700 font-bold"><%= item.reward %></p>
                            </div>
                        </div>
                    </div>

                    <a href="/daftar/<%= item.slug %>" class="bg-rose-600 text-white py-4 rounded-2xl text-center font-bold hover:bg-rose-700 shadow-lg shadow-rose-600/20 transition-all">
                        Ikuti Sekarang <i class="fas fa-arrow-right ml-2 text-xs"></i>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
