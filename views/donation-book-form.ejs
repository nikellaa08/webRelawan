<%- include('partials/header') %>

    <style>
        .form-container-buku {
            max-width: 500px;
            margin: 120px auto 60px;
            padding: 40px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .form-container-buku h1 {
            text-align: center;
            margin-bottom: 30px;
            color: #764ba2;
        }
        .form-group-buku {
            margin-bottom: 20px;
        }
        .form-group-buku label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }
        .form-group-buku input[type="text"],
        .form-group-buku input[type="email"],
        .form-group-buku input[type="tel"],
        .form-group-buku input[type="number"],
        .form-group-buku select,
        .form-group-buku textarea,
        .form-group-buku input[type="file"] {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ddd;
            font-family: inherit;
            font-size: 1rem;
            box-sizing: border-box;
        }
        .form-group-buku textarea {
            resize: vertical;
            min-height: 100px;
        }
        .form-group-buku .radio-group-buku {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }
        .form-group-buku .radio-group-buku label {
            display: flex;
            align-items: center;
            font-weight: 400;
            margin-bottom: 0;
        }
        .form-group-buku .radio-group-buku input[type="radio"] {
            width: auto;
            margin-right: 8px;
        }
        .btn-buku-submit {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .btn-buku-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(118, 75, 162, 0.4);
        }
    </style>

    <section class="section">
        <div class="form-container-buku">
            <h1>Donasi Buku<br><small style="font-weight: 400; font-size: 0.6em;">untuk Masa Depan</small></h1>
            <form id="bookDonationForm">
                <div class="form-group-buku">
                    <label for="donatorName">Nama Donatur:</label>
                    <input type="text" id="donatorName" name="donatorName" required>
                </div>
                <div class="form-group-buku">
                    <label for="contact">No. HP / Email:</label>
                    <input type="text" id="contact" name="contact" required>
                </div>
                <div class="form-group-buku">
                    <label for="bookCategory">Jenis Buku:</label>
                    <select id="bookCategory" name="bookCategory" required>
                        <option value="">Pilih Jenis Buku</option>
                        <option value="fiksi">Fiksi</option>
                        <option value="nonfiksi">NonFiksi</option>
                        <option value="pilih_sendiri">Lainnya</option>
                    </select>
                </div>
                <div class="form-group-buku">
                    <label for="numberOfBooks">Jumlah Buku:</label>
                    <input type="number" id="numberOfBooks" name="numberOfBooks" min="1" required>
                </div>
                <div class="form-group-buku">
                    <label for="bookCondition">Kondisi Buku:</label>
                    <select id="bookCondition" name="bookCondition" required>
                        <option value="">Pilih Kondisi</option>
                        <option value="sangat_baik">Sangat Baik</option>
                        <option value="baik">Baik</option>
                        <option value="cukup">Cukup</option>
                    </select>
                </div>
                <div class="form-group-buku">
                    <label for="deliveryMethod">Metode Pengiriman:</label>
                    <div class="radio-group-buku">
                        <label><input type="radio" name="deliveryMethod" value="dijemput" required> Dijemput</label>
                        <label><input type="radio" name="deliveryMethod" value="antar"> Antar Sendiri</label>
                    </div>
                </div>
                <div class="form-group-buku">
                    <label for="pickupAddress">Alamat / Catatan:</label>
                    <textarea id="pickupAddress" name="pickupAddress" rows="3"></textarea>
                </div>
                
                <button type="submit" class="btn-buku-submit">Donasikan Sekarang</button>
            </form>
        </div>
    </section>

    <footer class="footer">
        <p>&copy; 2026 Relawan Nusantara. Semua Hak Dilindungi.</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('bookDonationForm');
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                alert('Buku Anda sangat berharga! Terima kasih.');
                window.location.href = '/sosial-kemanusiaan';
            });
        });
    </script>
</body>
</html>
