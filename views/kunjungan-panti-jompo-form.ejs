<%- include('partials/header') %>

    <style>
        .form-container-visit {
            max-width: 500px;
            margin: 120px auto 60px;
            padding: 40px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .form-container-visit h1 {
            text-align: center;
            margin-bottom: 30px;
            color: #764ba2;
        }
        .form-group-visit {
            margin-bottom: 20px;
        }
        .form-group-visit label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }
        .form-group-visit input, .form-group-visit select, .form-group-visit textarea {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ddd;
            font-family: inherit;
        }
        .btn-visit-submit {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .btn-visit-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(118, 75, 162, 0.4);
        }
    </style>

    <section class="section">
        <div class="form-container-visit">
            <h1>Kunjungi Panti Jompo<br><small style="font-weight: 400; font-size: 0.6em;">Berbagi waktu, menghadirkan senyuman</small></h1>
            <form id="pantiJompoVisitForm">
                <div class="form-group-visit">
                    <label for="volunteerName">Nama Relawan:</label>
                    <input type="text" id="volunteerName" name="volunteerName" required>
                </div>
                <div class="form-group-visit">
                    <label for="volunteerAge">Usia Relawan:</label>
                    <input type="number" id="volunteerAge" name="volunteerAge" min="17" required>
                </div>
                <div class="form-group-visit">
                    <label for="contact">No. HP / Email:</label>
                    <input type="text" id="contact" name="contact" required>
                </div>
                <div class="form-group-visit">
                    <label for="visitDate">Pilih Jadwal:</label>
                    <input type="date" id="visitDate" name="visitDate" required>
                </div>
                <div class="form-group-visit">
                    <label for="activity">Pilih Aktivitas:</label>
                    <select id="activity" name="activity" required>
                        <option value="">Pilih Aktivitas</option>
                        <option value="ngobrol">Mendengar Cerita & Ngobrol</option>
                        <option value="senam">Senam Lansia Ringan</option>
                        <option value="musik">Bernyanyi & Musik</option>
                        <option value="permainan">Bermain Game Papan</option>
                        <option value="lainnya">Lainnya</option>
                    </select>
                </div>
                <div class="form-group-visit">
                    <label for="notes">Catatan Tambahan:</label>
                    <textarea id="notes" name="notes"></textarea>
                </div>
                
                <button type="submit" class="btn-visit-submit">Daftar & Tebar Kebaikan</button>
            </form>
        </div>
    </section>

    <footer class="footer">
        <p>&copy; 2026 Relawan Nusantara. Semua Hak Dilindungi.</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('pantiJompoVisitForm');
            form.addEventListener('submit', function(event) {
                event.preventDefault();
                alert('Terima kasih atas kepedulian Anda.');
                window.location.href = '/sosial-kemanusiaan';
            });
        });
    </script>
</body>
</html>
